# ---------------------------------------------------------------------------
# InfraSchouw — environment variables
# Kopieer naar .env.local (lokaal) of stel in bij Vercel → Project → Settings →
# Environment Variables. Alleen DATABASE_URL is strikt verplicht; alle andere
# integraties vallen netjes terug als ze ontbreken (zie README).
# ---------------------------------------------------------------------------

# Neon Postgres (met PostGIS). Gebruik de *pooled* connection string.
# PostGIS wordt door de eerste migratie aangezet (CREATE EXTENSION postgis).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Optioneel: max. connecties per serverinstantie (standaard 5).
DATABASE_POOL_MAX=5

# Clerk (auth + Organizations). Zonder deze sleutels draait de app alleen in DEMO_MODE.
# Dashboard → API keys. Zet Organizations aan (Configure → Organizations).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Webhook signing secret (Dashboard → Webhooks → endpoint https://<app>/api/webhooks/clerk,
# events: user.*, organization.*, organizationMembership.*).
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel Blob (media, exports). Maak een *private* Blob store aan en koppel die aan het project.
# Zonder token worden bestanden lokaal in ./.data/uploads opgeslagen (alleen voor lokaal gebruik).
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (rate limiting). Zonder: in-memory limiter per instantie.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (achtergrondjobs voor AI). Zonder: jobs draaien direct na de response (after()).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# OpenAI. Zonder sleutel blijft de app werken; AI-stappen krijgen status "overgeslagen".
OPENAI_API_KEY=
# Model met vision + structured outputs (foto-analyse, typeplaat-OCR).
OPENAI_MODEL_VISION=gpt-6-luna
# Sterk redeneermodel met structured outputs (verslag-synthese).
OPENAI_MODEL_REPORT=gpt-6-astra
# Transcriptiemodel met goede NL-ondersteuning.
OPENAI_MODEL_TRANSCRIBE=gpt-4o-transcribe-diarize

# Publieke basis-URL van de app (voor QStash-callbacks, deellinks en e-mails).
APP_URL=http://localhost:3000

# Demo-modus: demo-login zonder Clerk + banner "demo-omgeving". Nooit aanzetten in productie met echte data.
DEMO_MODE=false

# Beveiligt de cron-routes (/api/cron/*). Standaard zijn er geen crons ingesteld in vercel.json;
# alleen nodig als je ze toevoegt (Vercel Cron stuurt dit dan automatisch mee).
CRON_SECRET=
